#!/usr/bin/env python3

import json
from pathlib import Path
import sys


def main():
    if len(sys.argv) > 2:
        print("Usage: ifba-os-version [build-info.json]", file=sys.stderr)
        return 2
    manifest = Path(sys.argv[1]) if len(sys.argv) == 2 else Path("/usr/share/ifba-os/build-info.json")
    try:
        info = json.loads(manifest.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        print(f"Unable to read IFBA OS build information: {error}", file=sys.stderr)
        return 1
    for label, key in (
        ("IFBA OS", "system_version"),
        ("Architecture", "architecture"),
        ("Build ID", "build_id"),
        ("Source commit", "source_commit"),
        ("Built at (UTC)", "build_date_utc"),
    ):
        value = info.get(key)
        if not isinstance(value, str) or not value:
            print(f"Invalid build information: missing {key}", file=sys.stderr)
            return 1
        print(f"{label}: {value}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

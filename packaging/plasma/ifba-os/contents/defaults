[kdeglobals][General]
ColorScheme=IFBA-OS-Dark
Name=IFBA OS Dark
Font=Inter,10,-1,5,50,0,0,0,0,0

[kdeglobals][KDE]
LookAndFeelPackage=org.ifbaos.desktop
SingleClick=false

[kwinrc][Desktops]
Number=1
Rows=1

[kwinrc][Windows]
Placement=Centered
TitlebarDoubleClickCommand=Maximize

[kwinrc][org.kde.kdecoration2]
ButtonsOnLeft=XIA
ButtonsOnRight=
library=org.kde.kwin.aurorae
theme=__aurorae__svg__IFBA-Window
BorderSize=Tiny

[kwinrc][Plugins]
blurEnabled=true
magiclampEnabled=true
overviewEnabled=true
squashEnabled=false
scaleEnabled=true
fadeEnabled=false
maximizeEnabled=true
slideEnabled=true
fadedesktopEnabled=false

[kwinrc][Effect-Blur]
BlurStrength=2

[kwinrc][Effect-magiclamp]
AnimationDuration=180

[kwinrc][Effect-scale]
Duration=180

[kwinrc][Effect-overview]
BorderActivate=9

[plasmarc][Theme]
name=IFBA-WhiteSur-Dark

[plasmashellrc][Shell]
ShellPackage=org.kde.plasma.desktop

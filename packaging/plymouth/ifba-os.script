Window.SetBackgroundTopColor (0, 0, 0);
Window.SetBackgroundBottomColor (0, 0, 0);

frame_count = @FRAME_COUNT@;
frame_rate = @FRAME_RATE@;
current_frame = 0;
animation_started = null;
prompt_active = 0;
boot_sprite = Sprite ();
message_sprite = Sprite ();
message_sprite.SetZ (10);
prompt_sprite = Sprite ();
prompt_sprite.SetZ (20);

fun show_image (image) {
  local.scale = Window.GetWidth () / image.GetWidth ();
  local.vertical_scale = Window.GetHeight () / image.GetHeight ();
  if (local.vertical_scale < local.scale) local.scale = local.vertical_scale;
  if (local.scale != 1)
    image = image.Scale (image.GetWidth () * local.scale, image.GetHeight () * local.scale);
  boot_sprite.SetImage (image);
  boot_sprite.SetX (Window.GetX () + (Window.GetWidth () - image.GetWidth ()) / 2);
  boot_sprite.SetY (Window.GetY () + (Window.GetHeight () - image.GetHeight ()) / 2);
}

fun show_frame (index) {
  local.prefix = "";
  if (index < 100) local.prefix += "0";
  if (index < 10) local.prefix += "0";
  local.image = Image ("frame-" + local.prefix + index + ".png");
  if (!local.image) {
    show_image (Image ("ifba-os-startup.png"));
    global.frame_count = 0;
    return;
  }
  show_image (local.image);
  global.current_frame = index;
}

fun advance_animation (elapsed, progress) {
  if (global.animation_started == null) global.animation_started = elapsed;
  if (prompt_active || frame_count == 0) return;
  local.index = Math.Int ((elapsed - animation_started) * frame_rate) + 1;
  if (local.index < 1) local.index = 1;
  if (local.index > frame_count) local.index = frame_count;
  if (local.index != current_frame) show_frame (local.index);
}

fun show_text (sprite, text, fraction) {
  local.image = Image.Text (text, 1, 1, 1);
  sprite.SetImage (local.image);
  sprite.SetX (Window.GetX () + (Window.GetWidth () - local.image.GetWidth ()) / 2);
  sprite.SetY (Window.GetY () + Window.GetHeight () * fraction - local.image.GetHeight () / 2);
  sprite.SetOpacity (1);
}

fun display_question (prompt, entry) {
  global.prompt_active = 1;
  boot_sprite.SetOpacity (0.2);
  message_sprite.SetOpacity (0);
  show_text (prompt_sprite, prompt + "\n" + entry, 0.62);
}

fun display_password (prompt, bullet_count) {
  local.entry = "";
  for (local.i = 0; local.i < bullet_count; local.i++) local.entry += "*";
  display_question (prompt, local.entry);
}

fun display_normal () {
  global.prompt_active = 0;
  prompt_sprite.SetOpacity (0);
  boot_sprite.SetOpacity (1);
}

fun display_message (text) {
  if (!prompt_active) show_text (message_sprite, text, 0.90);
}

fun hide_message (text) {
  message_sprite.SetOpacity (0);
}

Plymouth.SetDisplayPasswordFunction (display_password);
Plymouth.SetDisplayQuestionFunction (display_question);
Plymouth.SetDisplayNormalFunction (display_normal);
Plymouth.SetDisplayMessageFunction (display_message);
Plymouth.SetHideMessageFunction (hide_message);
if (Plymouth.GetMode () == "boot" && frame_count > 0) {
  show_frame (1);
  Plymouth.SetBootProgressFunction (advance_animation);
} else {
  show_image (Image ("ifba-os-startup.png"));
}

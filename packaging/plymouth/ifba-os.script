Window.SetBackgroundTopColor (0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor (0.0, 0.0, 0.0);

fun pad3 (n) {
  if (n < 10) return "00" + n;
  if (n < 100) return "0" + n;
  return "" + n;
}

fun fit_image (img) {
  scale_x = Window.GetWidth () / img.GetWidth ();
  scale_y = Window.GetHeight () / img.GetHeight ();
  if (scale_x < scale_y)
    scale = scale_x;
  else
    scale = scale_y;
  return img.Scale (img.GetWidth () * scale, img.GetHeight () * scale);
}

frames = [];
frame_count = 0;
for (i = 1; i <= 180; i++) {
  raw = Image ("frame-" + pad3 (i) + ".png");
  if (!raw) break;
  frames[frame_count] = fit_image (raw);
  frame_count++;
}

startup_sprite = Sprite ();
startup_sprite.SetZ (0);

if (frame_count > 0) {
  startup_sprite.SetImage (frames[0]);
  startup_sprite.SetX (Window.GetWidth () / 2 - frames[0].GetWidth () / 2);
  startup_sprite.SetY (Window.GetHeight () / 2 - frames[0].GetHeight () / 2);

  tick = 0;
  fun refresh_callback () {
    tick++;
    # Plymouth refresh runs at ~50 Hz; advance 1 frame every 4 ticks (~12.5 fps).
    idx = Math.Int (tick / 4) % frame_count;
    img = frames[idx];
    startup_sprite.SetImage (img);
  }
  Plymouth.SetRefreshFunction (refresh_callback);
} else {
  startup_image = fit_image (Image ("ifba-os-startup.png"));
  startup_sprite.SetImage (startup_image);
  startup_sprite.SetX (Window.GetWidth () / 2 - startup_image.GetWidth () / 2);
  startup_sprite.SetY (Window.GetHeight () / 2 - startup_image.GetHeight () / 2);
}

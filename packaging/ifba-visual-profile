#!/bin/sh
# Apply an explicitly selected KWin visual profile for the current user.
set -eu

usage() {
  printf 'Uso: ifba-visual-profile {leve|equilibrado|avancado|status}\n' >&2
}

if [ "$#" -ne 1 ]; then
  usage
  exit 2
fi

profile=$1

read_motion_duration() {
  key=$1
  fallback=$2
  value=$fallback
  if command -v kreadconfig6 >/dev/null 2>&1; then
    value=$(kreadconfig6 --file /usr/share/ifba-os/design-system/visual-motionrc \
      --group Motion --key "$key" --default "$fallback" 2>/dev/null) || value=$fallback
  fi
  case "$value" in
    ''|*[!0-9]*) value=$fallback ;;
  esac
  printf '%s\n' "$value"
}

fast_duration=$(read_motion_duration DurationFastMs 140)
standard_duration=$(read_motion_duration DurationStandardMs 210)
slow_duration=$(read_motion_duration DurationSlowMs 270)

case "$profile" in
  status)
    if command -v kreadconfig6 >/dev/null 2>&1; then
      enabled=$(kreadconfig6 --file kwinrc --group Plugins --key blurEnabled --default false)
      strength=$(kreadconfig6 --file kwinrc --group Effect-Blur --key BlurStrength --default 0)
      magiclamp=$(kreadconfig6 --file kwinrc --group Plugins --key magiclampEnabled --default false)
      duration=$(kreadconfig6 --file kwinrc --group Effect-magiclamp --key AnimationDuration --default 0)
      printf 'blur=%s\nblur_strength=%s\nmagiclamp=%s\nmagiclamp_duration_ms=%s\n' \
        "$enabled" "$strength" "$magiclamp" "$duration"
      exit 0
    fi
    printf 'kreadconfig6 não está disponível nesta sessão.\n' >&2
    exit 1
    ;;
  leve)
    animated=false
    blur=false
    strength=0
    magiclamp=false
    duration=$standard_duration
    ;;
  equilibrado)
    animated=true
    blur=true
    strength=2
    magiclamp=true
    duration=$standard_duration
    ;;
  avancado)
    animated=true
    blur=true
    strength=4
    magiclamp=true
    duration=$slow_duration
    ;;
  *)
    usage
    exit 2
    ;;
esac

if ! command -v kwriteconfig6 >/dev/null 2>&1; then
  printf 'kwriteconfig6 não está disponível nesta sessão.\n' >&2
  exit 1
fi

# Respect the KDE reduced-motion preference. A zero factor means the user has
# disabled animation; never change that preference or enable Magic Lamp then.
motion_factor=1
if command -v kreadconfig6 >/dev/null 2>&1; then
  motion_factor=$(kreadconfig6 --file kdeglobals --group KDE \
    --key AnimationDurationFactor --default 1 2>/dev/null || printf '1')
fi
if awk -v factor="$motion_factor" \
  'BEGIN { exit (factor ~ /^[0-9]+([.][0-9]*)?$/ && factor + 0 == 0) ? 0 : 1 }'; then
  magiclamp=false
  animated=false
fi

# These are user-invoked, current-user KWin settings. Do not use sudo, edit
# other users' files, or change global speed/accessibility preferences.
kwriteconfig6 --file kwinrc --group Plugins --key blurEnabled "$blur"
kwriteconfig6 --file kwinrc --group Effect-Blur --key BlurStrength "$strength"
kwriteconfig6 --file kwinrc --group Plugins --key magiclampEnabled "$magiclamp"
kwriteconfig6 --file kwinrc --group Effect-magiclamp --key AnimationDuration "$duration"
# KWin's mutually exclusive animation categories must have one owner.
kwriteconfig6 --file kwinrc --group Plugins --key squashEnabled false
kwriteconfig6 --file kwinrc --group Plugins --key fadeEnabled false
kwriteconfig6 --file kwinrc --group Plugins --key scaleEnabled "$animated"
kwriteconfig6 --file kwinrc --group Plugins --key maximizeEnabled "$animated"
kwriteconfig6 --file kwinrc --group Plugins --key slideEnabled "$animated"
kwriteconfig6 --file kwinrc --group Plugins --key fadedesktopEnabled false
kwriteconfig6 --file kwinrc --group Effect-scale --key Duration "$duration"
kwriteconfig6 --file kwinrc --group Plugins --key slidingpopupsEnabled "$animated"
kwriteconfig6 --file kwinrc --group Plugins --key fadingpopupsEnabled "$animated"
kwriteconfig6 --file kwinrc --group Effect-slidingpopups --key SlideInTime "$duration"
kwriteconfig6 --file kwinrc --group Effect-slidingpopups --key SlideOutTime "$fast_duration"

# Reuse the packaged opaque Kvantum variant on low-end machines. Only switch
# IFBA themes: a personally selected third-party theme belongs to the user.
if command -v kreadconfig6 >/dev/null 2>&1; then
  qt_theme=$(kreadconfig6 --file Kvantum/kvantum.kvconfig --group General --key theme --default '' 2>/dev/null || true)
  case "$qt_theme" in
    IFBA-Glass|IFBA-Glass-Opaque)
      if [ "$profile" = leve ]; then qt_theme=IFBA-Glass-Opaque; else qt_theme=IFBA-Glass; fi
      kwriteconfig6 --file Kvantum/kvantum.kvconfig --group General --key theme "$qt_theme"
      printf 'Tema Qt: %s (reinicie os aplicativos Qt para aplicar).\n' "$qt_theme"
      ;;
  esac
fi

if command -v qdbus6 >/dev/null 2>&1 && qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1; then
  :
else
  printf 'Perfil salvo; KWin aplicará a alteração ao reconfigurar ou iniciar novamente.\n' >&2
fi

printf 'Perfil visual %s aplicado (blur=%s, intensidade=%s, Magic Lamp=%s, duração=%sms).\n' \
  "$profile" "$blur" "$strength" "$magiclamp" "$duration"
